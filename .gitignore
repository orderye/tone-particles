.DS_Store
__pycache__/
*.py[cod]

# CNB 发布用 worktree
/.cnb-worktree/

# 本地工具状态目录，不随仓库分发（通用点目录规则，不针对某个工具）
/.[a-z]*/
!/.github/

# 运行时生成的用户配置，不随仓库分发
config/user-config.json
config/tone-history.json

# 配置写入的跨进程锁文件（运行时生成）
config/*.lock
*.lock

# 评测时生成的一次性产物，可由脚本重新生成
/eval/blind_sheet.md
/eval/fixtures/judgments/*.json
/eval/report.md
/eval/report.json
/eval/model-report.md
/eval/model-report.json

# 分发包只挂在 Releases，不进仓库
/dist/
